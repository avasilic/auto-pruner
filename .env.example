DISCORD_TOKEN=
APPLICATION_ID=
# PostgreSQL connection string.
# When using docker compose, the bundled database is reachable as:
# postgresql://autopruner:autopruner@database:5432/autopruner
DATABASE_URL=

# Optional: leave AXIOM_TOKEN empty to disable it.
# Logs are always written to stdout regardless.
AXIOM_ORG_ID=
AXIOM_DATASET=
AXIOM_TOKEN=

# Only used by docker compose.
POSTGRES_USER=autopruner
POSTGRES_PASSWORD=autopruner
POSTGRES_DB=autopruner
