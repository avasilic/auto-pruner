{
	"name": "auto-pruner",
	"author": "avasilic",
	"description": "AutoPruner is a simple Discord bot that allows you to prune members on a customizable interval.",
	"license": "MIT",
	"version": "4.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"start": "bun run ./src/index.ts",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"deploy": "bun run ./src/util/deploy.ts",
		"format": "biome format . --write",
		"lint": "biome lint . --write",
		"lint:unsafe": "biome check . --write --unsafe",
		"pretty": "biome check . --write"
	},
	"dependencies": {
		"@axiomhq/pino": "^2.0.0",
		"@discordjs/core": "^2.6.0",
		"@discordjs/rest": "^2.6.3",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"croner": "^10.0.1",
		"discord.js": "^14.27.0",
		"human-interval": "^2.0.1",
		"ms": "^2.1.3",
		"nanoid": "^6.0.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/ms": "^2.1.0",
		"bun-types": "^1.3.14",
		"prisma": "^7.9.1",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@prisma/client",
		"@prisma/engines",
		"prisma"
	]
}
