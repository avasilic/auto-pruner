generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id            String    @id
  enabled       Boolean   @default(false)
  interval      DateTime?
  intervalHuman String?
  days          Int       @default(30)
  roles         Role[]
  logChannelId  String?
  lastPrune     DateTime?
}

model Role {
  id      String @id
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String

  @@index([guildId])
}
